        "dropout": 0.2,
        "final_dropout": true,
        "interleave_self_attention": true,
        "norm_type": "ada_norm",
        "num_layers": 16,
        "output_dim": 2560,
        "positional_embeddings": null
      }
    }
  },
  "datasets": {
