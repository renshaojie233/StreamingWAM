{
  "run_id": "dit4dit_joint",
  "run_root_dir": "runs",
  "seed": 42,
  "trackers": [
    "jsonl"
  ],
  "is_debug": false,
  "provenance": {
    "official_revision": "66a6f3a12e2c8740157c1e478795952c040d31dd",
